  "narrative": {
    "northStar": "The Counter Ledger",
    "overview": "ASNOR looks like a well-kept shop ledger that happens to be a web app: cream paper, a single clay-terracotta ink, hairline rules between rows, and figures set plainly so a price or a profit can be read at a glance across a counter. It is a working tool used all day by the owner and staff of a tech-resale shop, so the interface stays calm and gets out of the way. The warmth is real but quiet; nothing performs.\n\nThe mood is calm, warm and readable. It must never read as a cold enterprise dashboard, a neon fintech console, or a dense spreadsheet grid. Density is moderate and generous: 24px card padding, 32px between page sections, 14px body text. Colour is rationed so the one loud thing on any screen is the next action.",
    "keyCharacteristics": [
      "Cream page, white cards, warm hairline borders; depth is mostly borders and tone.",
      "One accent, clay terracotta, for the primary action, the active nav item and the lead chart series.",
      "Green and red appear only as money signals (gain/loss, growth) and status, never as decoration.",
      "Inter throughout, sentence case, weights 400 to 700, no display face.",
      "Soft, restrained controls: 12px control corners, 16px card corners, near-invisible shadows."
    ],
    "rules": [
      {
        "name": "The Field Edge Rule",
        "body": "A control's boundary is Field Border; a container's boundary is Warm Hairline. Never use the hairline to outline something the user has to type into.",
        "section": "colors"
      },
      {
        "name": "The One Clay Voice Rule",
        "body": "Clay terracotta is the only accent. If a second thing on a screen is terracotta and neither is the primary action or the current location, one of them is wrong.",
        "section": "colors"
      },
      {
        "name": "The Money Signal Rule",
        "body": "Green and red mean money or state (gain and loss, sell and buy price, available and for-parts), nothing else. They are never used to tint a card, a header or an icon for atmosphere.",
        "section": "colors"
      },
      {
        "name": "The Warm Neutral Rule",
        "body": "Every neutral leans warm (cream, parchment, sand, stone). No cool grey or pure black is introduced; ink is #1a1a1a.",
        "section": "colors"
      },
      {
        "name": "The Plain Figures Rule",
        "body": "Prices, counts and profits are set in Inter at the same weight as their neighbours (or 700 for the single headline metric), with tabular numerals so columns and metric rows align. No display numerals, no monospaced decoration, no gradient text.",
        "section": "typography"
      },
      {
        "name": "The Ambient Lift Rule",
        "body": "Shadows never exceed 5% black. A shadow that can be seen on its own is too strong; it exists to hint at a layer, not to draw it.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep Clay Terracotta (#ad4f2d) for the primary action, active location, focus rings, links and the lead chart series.",
      "**Do** sit content on Card White over Ledger Cream with a 1px Warm Hairline, and keep shadows at or below the Rest, Lift and Float values.",
      "**Do** use Gain Green and Alert Red only for money and state (profit, loss, growth, prices, status), and always pair them with a sign, a label or an icon so colour is never the only cue.",
      "**Do** keep controls at 40px tall with 12px corners and the clay focus ring, and cards at 16px corners with 24px padding.",
      "**Do** set secondary information in Stone Text at 12 to 14px under the primary line, as the dashboard list rows do."
    ],
    "donts": [
      "**Don't** introduce a second accent hue, a gradient, or a cool grey; the palette is warm neutrals plus clay.",
      "**Don't** make it look like a cold enterprise dashboard, a neon fintech console or a dense spreadsheet grid.",
      "**Don't** use shadows that read as a dark outline, or use elevation to rank importance on the page; use size and weight instead.",
      "**Don't** tint whole cards, headers or backgrounds green or red.",
      "**Don't** add a display typeface or monospaced numerals for effect; Inter at its existing weights carries the system.",
      "**Don't** use pill-shaped buttons or inputs; full rounding belongs to badges and avatar chips."
    ]
  }
}
