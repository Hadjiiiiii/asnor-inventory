# Database (Neon free tier: https://neon.tech)
DATABASE_URL="postgresql://user:password@host:5432/asnor_inventory?schema=public"

# NextAuth (generate with: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Cloudinary (free tier: https://cloudinary.com)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# The shop's time zone (IANA name). "Today" and "this month" on the dashboard follow it.
# Unset, the server's own zone is used, which is UTC on most hosts.
SHOP_TIMEZONE="America/New_York"
